# ---------------------------------------------------------------------------
# Frontend Portofolio Kelas — contoh konfigurasi environment
# Salin menjadi `.env` bila perlu menyesuaikan.
# ---------------------------------------------------------------------------

# Base URL backend API.
# Kosongkan (default) bila frontend & API disajikan pada origin yang sama /
# di belakang reverse proxy — dev server Vite sudah memproxy /api dan /uploads.
VITE_API_URL=""

# Target proxy saat `bun run dev` (backend Hono).
VITE_API_PROXY="http://localhost:8787"