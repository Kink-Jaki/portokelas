{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "bun run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://portofolio-kelas-api.fzaky474.workers.dev/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://portofolio-kelas-api.fzaky474.workers.dev/uploads/:path*"
    },
    {
      "source": "/((?!api/|uploads/).*)",
      "destination": "/index.html"
    }
  ]
}
