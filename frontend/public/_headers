# Jangan sajikan index.html basi: HTML selalu revalidasi ke server,
# aset ber-hash (nama file berubah tiap build) boleh di-cache lama.
/*
  Cache-Control: public, max-age=0, must-revalidate

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Respons API memuat data autentik — jangan disimpan cache browser/proxy.
/api/*
  Cache-Control: no-store
