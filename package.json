{
  "name": "craftly",
  "version": "1.0.0",
  "private": true,
  "description": "Craftly — kreator mendaftarkan diri dan menampilkan project mereka lewat portofolio publik.",
  "type": "module",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "dev:backend": "bun run --cwd backend dev",
    "dev:frontend": "bun run --cwd frontend dev",
    "build": "bun run --filter '*' build",
    "start": "bun run --cwd backend start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,css,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,css,json,md}\"",
    "typecheck": "bun run --filter '*' typecheck",
    "db:generate": "bun run --cwd backend db:generate",
    "db:migrate": "bun run --cwd backend db:migrate",
    "db:push": "bun run --cwd backend db:push",
    "db:studio": "bun run --cwd backend db:studio",
    "seed:admin": "bun run --cwd backend seed:admin",
    "seed:class": "bun run --cwd backend seed:class",
    "seed:teachers": "bun run --cwd backend seed:teachers"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1"
  },
  "engines": {
    "bun": ">=1.1.0"
  }
}
