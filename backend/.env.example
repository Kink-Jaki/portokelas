# ---------------------------------------------------------------------------
# Backend Portofolio Kelas — contoh konfigurasi environment
# Salin file ini menjadi `.env` lalu isi dengan nilai aslimi.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# --- Database ---------------------------------------------------------------
# String koneksi PostgreSQL (Supabase -> Project Settings -> Database ->
# Connection string -> URI, pilih driver "URI"). Jangan lupa ganti password.
DATABASE_URL="postgresql://postgres:PASSWORD@db.XXXX.supabase.co:5432/postgres"

# true jika provider memakai sertifikat SSL (umumnya Supabase produksi: true)
DATABASE_SSL="false"

# --- Server -----------------------------------------------------------------
NODE_ENV="development"
PORT="8787"

# --- Auth -------------------------------------------------------------------
# WAJIB diganti. Minimal 32 karakter. Hasil: openssl rand -base64 48
JWT_SECRET="ganti-dengan-secret-acak-minimal-32-karakter-panjang"
# Format: 30s | 15m | 12h | 7d
JWT_EXPIRES_IN="7d"
COOKIE_NAME="pk_session"

# --- CORS -------------------------------------------------------------------
# Origin frontend yang diizinkan, pisahkan dengan koma.
CORS_ORIGIN="http://localhost:5173"

# --- Upload -----------------------------------------------------------------
# Folder penyimpanan file ( relatif terhadap folder backend )
UPLOAD_DIR="uploads"
# URL publik untuk file yang diunggah
PUBLIC_URL="http://localhost:8787"
MAX_UPLOAD_SIZE_MB="2"

# --- Seed admin (dipakai oleh `bun run seed:admin`) --------------------------
ADMIN_NAME="Admin Kelas"
# ADMIN_NIM telah dihapus (tidak digunakan lagi)
ADMIN_EMAIL="admin@portofolio.test"
ADMIN_PASSWORD="Admin12345"