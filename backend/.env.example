# ---------------------------------------------------------------------------
# Backend Craftly — contoh konfigurasi environment
# Salin file ini menjadi `.env` lalu isi dengan nilai aslimi.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# --- Database ---------------------------------------------------------------
# PostgreSQL lokal (default, mis. Laragon/XAMPP/Docker). Ganti user/password
# dan nama database sesuai mesin masing-masing. Buat db dulu, contoh:
#   createdb craftly   (atau lewat phpMyAdmin/pgAdmin)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/craftly"

# Alternatif Neon (dipakai untuk produksi lewat Hyperdrive). Ambil dari Neon
# Console -> Connection string. Sertakan `?sslmode=require`. Untuk migrasi/seed
# lokal boleh pakai host pooled (ber-"-pooler"); untuk Hyperdrive JANGAN.
# DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx.<region>.aws.neon.tech/<db>?sslmode=require"

# Alternatif Supabase: Project Settings -> Database -> Connection string -> URI
# DATABASE_URL="postgresql://postgres:PASSWORD@db.XXXX.supabase.co:5432/postgres"

# true jika provider memakai sertifikat SSL (Neon/Supabase produksi: true,
# PostgreSQL lokal: false)
DATABASE_SSL="false"

# --- Server -----------------------------------------------------------------
NODE_ENV="development"
PORT="8787"

# --- Auth -------------------------------------------------------------------
# WAJIB diganti. Minimal 32 karakter. Generate salah satu:
#   openssl rand -base64 48
#   bun -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
JWT_SECRET="ganti-dengan-secret-acak-minimal-32-karakter-panjang"
# Format: 30s | 15m | 12h | 7d
JWT_EXPIRES_IN="7d"
COOKIE_NAME="craftly_session"

# --- CORS -------------------------------------------------------------------
# Origin frontend yang diizinkan, pisahkan dengan koma.
CORS_ORIGIN="http://localhost:5173"

# --- Upload -----------------------------------------------------------------
# Folder penyimpanan file ( relatif terhadap folder backend )
UPLOAD_DIR="uploads"
# URL publik untuk file yang diunggah
PUBLIC_URL="http://localhost:8787"
MAX_UPLOAD_SIZE_MB="2"

# --- Seed admin (OPSIONAL — hanya untuk `bun run seed:admin`) ----------------
# Seeder utama Craftly adalah `bun run seed:class` dan TIDAK butuh variabel ini:
# ia menghapus semua akun lalu membuat 31 akun kreator awal (login pakai NIS,
# password default "password"). Isi di bawah hanya bila ingin akun admin
# terpisah lewat `bun run seed:admin`.
ADMIN_NAME="Admin Craftly"
ADMIN_EMAIL="admin@craftly.test"
ADMIN_PASSWORD="Admin12345"
